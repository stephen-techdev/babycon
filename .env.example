# ── Babycon environment ────────────────────────────────────────────────
# SQLite file location (defaults to ./data/babycon.db)
DATABASE_PATH=./data/babycon.db

# Secret used to sign session cookies. Change this before deploying.
SESSION_SECRET=change-me-to-a-long-random-string

# Default admin account (used only when the database is first seeded)
ADMIN_EMAIL=admin@babycon.in
ADMIN_PASSWORD=Admin@12345

# Storefront URL used in metadata / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment mode. "demo" shows the built-in Razorpay test checkout.
# Real payments are intentionally NOT wired up.
NEXT_PUBLIC_PAYMENT_MODE=demo

# Optional: public Razorpay test key id to display in the demo checkout.
# This is display-only; no real charge is ever created.
NEXT_PUBLIC_RAZORPAY_TEST_KEY=rzp_test_BabyconDemo
